desc: 542 Tape Emulator (JSFX Analog Saturation)


// --- EXACT HARDWARE PARAMETERS (SLIDERS FOR AUTOMATION) ---
slider1:0<-12,12,0.1>Ch A Trim (dB)
slider2:0<0,100,0.1>Ch A Saturation (%)
slider3:100<0,100,0.1>Ch A Blend (%)
slider4:0<0,100,0.1>Ch A Texture (%)
slider5:0<0,1,1{15 IPS (Warm/Fat),30 IPS (Clear/Detailed)}>Ch A IPS
slider6:1<0,1,1{OFF,IN}>Ch A Tape Effect
slider7:0<0,1,1{Silk Blue,Silk Red}>Ch A Silk Mode

slider8:0<-12,12,0.1>Ch B Trim (dB)
slider9:0<0,100,0.1>Ch B Saturation (%)
slider10:100<0,100,0.1>Ch B Blend (%)
slider11:0<0,100,0.1>Ch B Texture (%)
slider12:0<0,1,1{15 IPS (Warm/Fat),30 IPS (Clear/Detailed)}>Ch B IPS
slider13:1<0,1,1{OFF,IN}>Ch B Tape Effect
slider14:0<0,1,1{Silk Blue,Silk Red}>Ch B Silk Mode

slider15:0<-15,15,0.1>Ch A Output (dB)
slider16:0<-15,15,0.1>Ch B Output (dB)
slider17:1<0,2,1{Dual Mono,Stereo,M/S}>Processing Mode
slider18:0<0,1,1{OFF,LINK}>Link Channels

@init
gfx_w = 580;
gfx_h = 620;

// Internal state variables for Silk EQ filters
s_l1 = 0; s_r1 = 0;
s_l2 = 0; s_r2 = 0;

@slider
// Pre-calculate gain stages
trim_a = 10 ^ (slider1 / 20);
sat_a  = slider2 / 100;
mix_a  = slider3 / 100;
tex_a  = slider4 / 100;
ips_a  = slider5;
on_a   = slider6;
silk_a = slider7;

trim_b = 10 ^ (slider8 / 20);
sat_b  = slider9 / 100;
mix_b  = slider10 / 100;
tex_b  = slider11 / 100;
ips_b  = slider12;
on_b   = slider13;
silk_b = slider14;

out_a  = 10 ^ (slider15 / 20);
out_b  = 10 ^ (slider16 / 20);
mode   = slider17;
link   = slider18;

// Link channel controls if Link is active
link ? (
  slider8 = slider1; slider9 = slider2; slider10 = slider3;
  slider11 = slider4; slider12 = slider5; slider13 = slider6; slider14 = slider7;
);

@sample
// Channel Input Matrix
mode == 2 ? (
  // Mid/Side Encoding
  mid  = (spl0 + spl1) * 0.5;
  side = (spl0 - spl1) * 0.5;
  ch_a = mid;
  ch_b = side;
) : (
  ch_a = spl0;
  ch_b = spl1;
);

// --- CHANNEL A DSP ---
x_a = ch_a * trim_a;
on_a ? (
  // IPS Head Frequency Curve
  fc_a = (ips_a == 0) ? 11000 : 18000;
  coeff_a = exp(-2 * $pi * (fc_a / srate));
  
  // Saturation Stage (Hyperbolic Tangent curve)
  drive_a = 1 + (sat_a * 8);
  arg_a = x_a * drive_a;
  sat_out_a = (exp(2 * arg_a) - 1) / (exp(2 * arg_a) + 1);
  
  // Silk EQ Stage (Red = High Boost, Blue = Low-Mid Transformer Bump)
  silk_a == 1 ? (
    // Silk Red
    s_l1 = s_l1 * 0.85 + sat_out_a * 0.15;
    silk_out_a = sat_out_a + (sat_out_a - s_l1) * (tex_a * 2.5);
  ) : (
    // Silk Blue
    s_l1 = s_l1 * 0.92 + sat_out_a * 0.08;
    silk_out_a = sat_out_a + s_l1 * (tex_a * 1.8);
  );
  
  proc_a = (x_a * (1 - mix_a)) + (silk_out_a * mix_a);
) : (
  proc_a = x_a;
);
proc_a *= out_a;

// --- CHANNEL B DSP ---
x_b = ch_b * trim_b;
on_b ? (
  fc_b = (ips_b == 0) ? 11000 : 18000;
  coeff_b = exp(-2 * $pi * (fc_b / srate));
  
  drive_b = 1 + (sat_b * 8);
  arg_b = x_b * drive_b;
  sat_out_b = (exp(2 * arg_b) - 1) / (exp(2 * arg_b) + 1);
  
  silk_b == 1 ? (
    s_r1 = s_r1 * 0.85 + sat_out_b * 0.15;
    silk_out_b = sat_out_b + (sat_out_b - s_r1) * (tex_b * 2.5);
  ) : (
    s_r1 = s_r1 * 0.92 + sat_out_b * 0.08;
    silk_out_b = sat_out_b + s_r1 * (tex_b * 1.8);
  );
  
  proc_b = (x_b * (1 - mix_b)) + (silk_out_b * mix_b);
) : (
  proc_b = x_b;
);
proc_b *= out_b;

// Channel Output Matrix
mode == 2 ? (
  // Mid/Side Decoding back to L/R
  spl0 = proc_a + proc_b;
  spl1 = proc_a - proc_b;
) : (
  spl0 = proc_a;
  spl1 = proc_b;
);

@gfx 580 620
// --- RENDER CUSTOM GRAPHICAL INTERFACE ---
gfx_r = 0.88; gfx_g = 0.91; gfx_b = 0.94; // Hardware Faceplate Color
gfx_rect(0, 0, gfx_w, gfx_h);

// Draw Titles
gfx_r = 0.1; gfx_g = 0.2; gfx_b = 0.4;
gfx_x = 20; gfx_y = 15;
gfx_drawstr("542 Tape Emulator");

// Panel Separators
gfx_r = 0.6; gfx_g = 0.65; gfx_b = 0.7;
gfx_line(190, 0, 190, gfx_h);
gfx_line(380, 0, 380, gfx_h);

// Section Header Labels
gfx_x = 65; gfx_y = 45; gfx_drawstr("CH A (MID)");
gfx_x = 255; gfx_y = 45; gfx_drawstr("CH B (SIDE)");
gfx_x = 440; gfx_y = 45; gfx_drawstr("MASTER / VU");

// Visual VU Meters (Top Right)
gfx_r = 0.1; gfx_g = 0.1; gfx_b = 0.1;
gfx_rect(400, 70, 160, 60);
gfx_rect(400, 140, 160, 60);

gfx_r = 0.9; gfx_g = 0.85; gfx_b = 0.5; // Meter Backlight
gfx_rect(403, 73, 154, 54);
gfx_rect(403, 143, 154, 54);

// Dynamic VU Meter Needles
meter_a = min(abs(spl0) * 120, 140);
meter_b = min(abs(spl1) * 120, 140);

gfx_r = 0.8; gfx_g = 0.1; gfx_b = 0.1;
gfx_line(405 + meter_a, 120, 480, 80);
gfx_line(405 + meter_b, 190, 480, 150);

// Status Info Box
gfx_r = 0.2; gfx_g = 0.25; gfx_b = 0.3;
gfx_x = 20; gfx_y = 570;
gfx_drawstr("Click 'UI' button on top bar of REAPER plugin window to open slider view.");
